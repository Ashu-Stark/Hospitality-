# Backend base URL (no trailing slash). The deployed demo backend:
API_BASE_URL=https://hospitality-management-9jdk.onrender.com
# true  -> serve dashboard/mocks/*.json (captured from the live API; works offline)
# false -> call API_BASE_URL
USE_MOCKS=true
# Request timeouts in seconds (Render free tier can take ~30-60s to wake up)
API_TIMEOUT_S=30
ROSTER_TIMEOUT_S=45
# Default replacement-cost ASSUMPTION for the ROI card (editable in the UI)
REPLACEMENT_COST_INR=60000

# HOI platform API (tenants, users, dispatch, photos, inventory): "embedded" runs it in-process
PLATFORM_API_URL=embedded
