ml/data/features.csv
ml/data/pulse_features.csv
ml/data/workload_features.csv

# Audio stays local, even scripted HM-student recordings (also onboarding uploads)
ml/voice/clips/*.wav
ml/voice/clips/*.mp3
ml/voice/clips/*.m4a
ml/voice/clips/*.ogg
backend/onboarding/audio/

