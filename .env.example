# Copy to .env (gitignored) and fill in. Every service reads its own variables; MONGODB_URI is shared.

# ---- MongoDB Atlas (all services) -----------------------------------------
# One cluster, one database per service. Unset or "mongomock://" = in-memory (development/tests only).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=hoi-cluster
HOI_OPS_DB=hoi_ops
HOI_PLATFORM_DB=hoi_platform
HOI_PORTAL_DB=hoi_portal
# development | production   (production refuses to start with unsafe settings, including no MONGODB_URI)
HOI_ENV=production

# ---- ML / ops API (backend/) ------------------------------------------------
# "1" serves ml/data/mocks/*.json instead of the models
MOCK=0
CORS_ORIGINS=*
# Shared secret callers must send as the X-HOI-Key header (staff and retention data). Unset = open (local only).
# Set the SAME value on the dashboard services. e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
HOI_OPS_API_KEY=
# Optional voice transcription providers
GROQ_API_KEY=
SARVAM_API_KEY=

# ---- Platform API (platform_api/) -----------------------------------------
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
HOI_JWT_SECRET=change-me-to-a-long-random-string-of-48-characters
# Platform admin account "platform" is created on first start with this password (12+ chars)
HOI_ADMIN_PASSWORD=change-me-strong-admin-password
# One-click demo accounts: never true in production
HOI_DEMO_LOGIN=false
HOI_SEED_DEMO=false
# Browser origins allowed to call the API (the dashboard runs server-side, so usually only the public site)
HOI_CORS_ORIGINS=https://staff.example.com
# Public URL of the platform API; printed into room QR codes
HOI_PUBLIC_BASE_URL=https://staff.example.com
HOI_ACCESS_TTL_MINUTES=30
HOI_REFRESH_TTL_DAYS=14
HOI_LOGIN_RATE_PER_MINUTE=10

# ---- Tourism portal (portal/) ----------------------------------------------
PORTAL_JWT_SECRET=change-me-to-another-long-random-string-of-48-chars
# State admin account is created on first start with this password (12+ chars)
PORTAL_ADMIN_PASSWORD=change-me-strong-portal-admin-password
PORTAL_DEMO_LOGIN=false
PORTAL_SEED_DEMO=false
PORTAL_CORS_ORIGINS=https://portal.example.com
PORTAL_WEATHER_ENABLED=true

# ---- Dashboard (dashboard/) -------------------------------------------------
# ML / forecast / roster API, or USE_MOCKS=true for the captured demo data
API_BASE_URL=https://hospitality-management-9jdk.onrender.com
USE_MOCKS=false
# Same value as HOI_OPS_API_KEY of the ops API (sent only to API_BASE_URL / the known ops deployment / localhost)
# HOI_OPS_API_KEY=   (already set above when one .env serves both)
# Where staff phones and QR codes reach the platform API
PLATFORM_PUBLIC_URL=https://staff.example.com
