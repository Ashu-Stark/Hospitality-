# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Environments
.venv/
.env

# Data (ml/ project)
ml/data/*.db
# Generator-only hidden traits: never commit, never read from model training code.
ml/data/internal/
# Derived feature matrices: rebuilt by python run.py train / train-pulse / train-workload.
ml/data/features.csv
ml/data/pulse_features.csv
ml/data/workload_features.csv

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Voice clips (T11): audio stays local, even scripted HM-student recordings.
ml/voice/clips/*.wav
ml/voice/clips/*.mp3
ml/voice/clips/*.m4a
ml/voice/clips/*.ogg

# Backend (SQLite database is rebuilt from the synthetic ml data by the seed step)
backend/data/*.db
