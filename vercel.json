{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portal": {
      "root": "portal/",
      "framework": "fastapi",
      "entrypoint": "hoi_portal.main:app"
    },
    "website": {
      "root": "website/"
    }
  },
  "redirects": [
    { "source": "/site", "destination": "/site/", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/site/(.*)",
      "destination": { "service": "website" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "portal" }
    }
  ]
}
